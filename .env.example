# ==============================================================================
# GuardianGrid Environment Configuration
# Architecture A: Vercel Frontend (Vite SPA) + Google Cloud Run Backend (Express)
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND ENV VARS (Configure in Vercel Project Settings -> Environment Variables)
# NEVER put server secrets (Gemini, Twilio, Nexconn Secret, SQL, Maps Server Key)
# into VITE_* variables.
# ------------------------------------------------------------------------------

# Cloud Run Backend Base URL used by frontend API & SSE calls.
# Leave empty in local development to preserve same-origin /api/* behavior.
VITE_API_BASE_URL=""

# Google Maps Platform Browser Key (restrict by HTTP referrer to Vercel domain + localhost)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_BROWSER_API_KEY"
VITE_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# ------------------------------------------------------------------------------
# BACKEND ENV VARS (Configure on Google Cloud Run / AI Studio Secrets)
# ------------------------------------------------------------------------------

# Public URL of the Vercel Frontend (used for SMS/WhatsApp Field Kit deep links
# and /#/track/:token paramedic handoff links).
APP_URL="MY_APP_URL"

# Public URL of this Cloud Run Backend service (used for Twilio webhook
# X-Twilio-Signature HMAC validation on POST /api/sos/webhooks/twilio).
BACKEND_PUBLIC_URL="MY_BACKEND_PUBLIC_URL"

# Comma-separated allowed browser origins for strict CORS on Cloud Run
# (e.g. "https://your-app.vercel.app,https://your-custom-domain.com").
FRONTEND_ORIGIN=""

# Runtime Security Controls
ALLOW_DEMO_AUTH="false"
SOS_CHANNEL_SECRET=""
CRON_SECRET=""

# GEMINI_API_KEY: Required for Guardian Analyst & AI Medical Handoff (Server-Side ONLY)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Nexconn Chat & Call Credentials (Server-Side ONLY)
NEXCONN_APP_KEY="MY_NEXCONN_APP_KEY"
NEXCONN_APP_SECRET="MY_NEXCONN_APP_SECRET"
NEXCONN_PRIMARY_API_DOMAIN="https://your-primary-nexconn-api-domain"
NEXCONN_SECONDARY_API_DOMAIN="https://your-secondary-nexconn-api-domain"
NEXCONN_AREA_CODE="SG"

# PostgreSQL Connection Parameters (Cloud SQL / Supabase / Neon)
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# PostgreSQL TLS & Strict Production Persistence
SQL_SSL="false"
SQL_SSL_REJECT_UNAUTHORIZED="true"
USE_JSON_FALLBACK="false"
REQUIRE_POSTGRES="false"

# Multi-Tenant Default Organization
DEFAULT_ORGANIZATION_ID="org-guardian-grid-india"

# Google Maps Server-Side Key (NEVER prefix with VITE_: restrict to Routes, Places New, Geocoding)
GOOGLE_MAPS_SERVER_API_KEY="MY_GOOGLE_MAPS_SERVER_API_KEY"

# Out-of-Band Official Alerts (Server-Side ONLY — NEVER expose in frontend)
# SMS and WhatsApp are independent channels. WhatsApp requires whatsapp:+... sender.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WHATSAPP_FROM=""
ENABLE_ALERT_SIMULATOR="true"

# Optional Authorized On-Duty Official Contacts (E.164 format, e.g. +91...)
# Ambulance Control Room is ONLY notified when AMBULANCE_CONTROL_PHONE is explicitly configured.
OFFICIAL_DISPATCH_PHONE=""
OFFICIAL_SUPERVISOR_PHONE=""
AMBULANCE_CONTROL_PHONE=""
